# Copy this file to .env; do not commit .env.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables Langfuse traces for LangChain runs.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# EU cloud region. Use the URL for your chosen cloud region or self-hosted instance.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
